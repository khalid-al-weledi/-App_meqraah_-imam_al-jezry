
NODE_ENV=development
PORT=4000

# Supabase PostgreSQL
# ضع بيانات الاتصال الحقيقية في ملف .env المحلي أو إعدادات الاستضافة فقط
# لا تضع كلمة المرور الحقيقية في هذا الملف
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# الأمان: استبدل القيمة في بيئة التشغيل بمفتاح عشوائي قوي
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Telegram Bot
BOT_TOKEN=
ADMIN_GROUP_ID=

# إعدادات مقرأة الإمام الجزري
APP_NAME=مقرأة الإمام الجزري للإقراء والإجازة بالسند
APP_TIMEZONE=Africa/Addis_Ababa

# النظام المالي
PRICE_PER_MINUTE_ETB=5
WELCOME_MINUTES=30
MAX_ADVANCE_MINUTES=100

# واجهة الإدارة المحلية
CORS_ORIGIN=http://localhost:3000
